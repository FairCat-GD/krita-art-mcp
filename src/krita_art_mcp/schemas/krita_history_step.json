                  "undo",
                  "redo"
                ]
              },
              "steps_applied": {
                "type": "integer",
                "minimum": 0
              },
              "verified": {
                "type": "boolean"
              },
              "stopped": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "not_the_bridges_step",
                      "unconfirmed",
                      "document_unsafe"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "steps": {
                "type": "array",
