                  "type": "object",
                  "properties": {
                    "tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operation_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "tool",
                    "operation_id"
                  ],
                  "additionalProperties": false
                }
              },
              "undo_available": {
                "type": "integer",
                "minimum": 0
              },
              "redo_available": {
                "type": "integer",
                "minimum": 0
              },
              "region_px": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "content_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capture": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "uri": {
                        "type": "string",
                        "minLength": 2,
                        "pattern": "^/"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 2,
                        "pattern": "^/"
                      },
                      "mime_type": {
                        "const": "image/png"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "size_bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "retention_days": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "uri",
                      "path",
                      "mime_type",
                      "sha256",
                      "size_bytes",
                      "retention_days"
