              "action",
              "steps_applied",
              "verified",
              "stopped",
              "steps",
              "undo_available",
              "redo_available",
              "region_px",
              "content_sha256",
              "capture"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
