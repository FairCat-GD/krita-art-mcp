{
  "name": "krita_history_step",
  "description": "Undo or redo committed edits, or restore a named checkpoint.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guard": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "expected_revision",
          "request_id"
        ],
        "additionalProperties": false
      },
      "action": {
        "type": "string",
        "enum": [
          "undo",
          "redo",
          "restore_checkpoint"
        ]
      },
      "steps": {
        "type": "integer",
        "minimum": 1
      },
      "checkpoint_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "guard",
      "action",
      "steps",
      "checkpoint_id"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "restore_checkpoint"
            }
          }
        },
        "then": {
          "properties": {
            "checkpoint_id": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "const": 1
            }
          }
        },
        "else": {
          "properties": {
            "checkpoint_id": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.1.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "steps_applied": {
                "type": "integer"
              },
              "verified": {
                "type": "boolean"
              },
              "content_sha256": {
                "type": "string"
              }
            },
            "required": [
              "action",
              "steps_applied",
              "verified",
              "content_sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "steps_applied": {
                  "type": "integer"
                },
                "verified": {
                  "type": "boolean"
                },
                "content_sha256": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "steps_applied",
                "verified",
                "content_sha256"
              ],
              "additionalProperties": false
            },
            "error": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "failed"
            }
          }
        },
        "then": {
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "guard": {
        "document_id": "doc-1",
        "expected_revision": 12,
        "request_id": "req-001"
      },
      "action": "undo",
      "steps": 1,
      "checkpoint_id": null
    },
    "structuredContent": {
      "api_version": "0.1.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": 13,
      "operation_id": null,
      "data": {
        "action": "undo",
        "steps_applied": 1,
        "verified": true,
        "content_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
      },
      "error": null
    }
  }
}
