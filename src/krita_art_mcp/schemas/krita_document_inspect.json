{
  "name": "krita_document_inspect",
  "description": "Read document state, frame, layer tree, profile and protection policy.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "document_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "document_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.2.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "type": "null"
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "canvas_px": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 0
              },
              "frame": {
                "type": "integer"
              },
              "profile_id": {
                "type": "string"
              },
              "project_id": {
                "type": "string"
              },
              "dirty": {
                "type": "boolean"
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "parent_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "opacity": {
                      "type": "number"
                    },
                    "blend_mode": {
                      "type": "string"
                    },
                    "locked": {
                      "type": "boolean"
                    },
                    "alpha_locked": {
                      "type": "boolean"
                    },
                    "offset_px": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "minItems": 0
                    }
                  },
                  "required": [
                    "id",
                    "parent_id",
                    "name",
                    "type",
                    "visible",
                    "opacity",
                    "blend_mode",
                    "locked",
                    "alpha_locked",
                    "offset_px"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "protection_id": {
                "type": "string"
              },
              "active_edit_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "canvas_px",
              "frame",
              "profile_id",
              "project_id",
              "dirty",
              "layers",
              "protection_id",
              "active_edit_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "UNSUPPORTED_CAPABILITY",
                  "KRITA_NOT_RUNNING",
                  "PROTOCOL_MISMATCH",
                  "KRITA_MODAL_DIALOG",
                  "MULTIPLE_WINDOWS",
                  "BUSY",
                  "TIMEOUT",
                  "CANCELLED",
                  "REQUEST_ID_CONFLICT",
                  "DOCUMENT_NOT_FOUND",
                  "LAYER_NOT_FOUND",
                  "LOCKED_TARGET",
                  "LAYER_NOT_PAINTABLE",
                  "LAYER_HAS_LOCAL_SELECTION",
                  "PROTECTED_REGION_CHANGED",
                  "OUTSIDE_ALLOWED_MASK",
                  "RESOURCE_HASH_MISMATCH",
                  "SOURCE_HASH_MISMATCH",
                  "COLOR_PROFILE_MISMATCH",
                  "DOCUMENT_DIRTY",
                  "DOCUMENT_UNSAFE",
                  "DOCUMENT_READ_ONLY",
                  "DOCUMENT_IN_USE",
                  "SAVE_VERIFY_FAILED",
                  "PATH_NOT_ALLOWED",
                  "FILE_EXISTS",
                  "IO_ERROR",
                  "ROLLBACK_FAILED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "canvas_px": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 0
                },
                "frame": {
                  "type": "integer"
                },
                "profile_id": {
                  "type": "string"
                },
                "project_id": {
                  "type": "string"
                },
                "dirty": {
                  "type": "boolean"
                },
                "layers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "parent_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "visible": {
                        "type": "boolean"
                      },
                      "opacity": {
                        "type": "number"
                      },
                      "blend_mode": {
                        "type": "string"
                      },
                      "locked": {
                        "type": "boolean"
                      },
                      "alpha_locked": {
                        "type": "boolean"
                      },
                      "offset_px": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        },
                        "minItems": 0
                      }
                    },
                    "required": [
                      "id",
                      "parent_id",
                      "name",
                      "type",
                      "visible",
                      "opacity",
                      "blend_mode",
                      "locked",
                      "alpha_locked",
                      "offset_px"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "protection_id": {
                  "type": "string"
                },
                "active_edit_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "canvas_px",
                "frame",
                "profile_id",
                "project_id",
                "dirty",
                "layers",
                "protection_id",
                "active_edit_id"
              ],
              "additionalProperties": false
            },
            "error": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "failed",
                "cancelled"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "null"
            },
            "error": {
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "document_id": "doc-1"
    },
    "structuredContent": {
      "api_version": "0.2.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": null,
      "operation_id": null,
      "data": {
        "canvas_px": [
          128,
          128
        ],
        "frame": 0,
        "profile_id": "srgb-profile-1",
        "project_id": "project-1",
        "dirty": true,
        "layers": [
          {
            "id": "base-1",
            "parent_id": "root-1",
            "name": "Accepted base",
            "type": "paint",
            "visible": true,
            "opacity": 1.0,
            "blend_mode": "normal",
            "locked": true,
            "alpha_locked": false,
            "offset_px": [
              0,
              0
            ]
          }
        ],
        "protection_id": "protect-1",
        "active_edit_id": null
      },
      "error": null
    }
  }
}
