    "structuredContent": {
      "api_version": "0.1.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": 1,
      "operation_id": null,
      "data": {
        "canvas_px": [
          32,
          32
        ],
        "root_layer_id": "root-2",
