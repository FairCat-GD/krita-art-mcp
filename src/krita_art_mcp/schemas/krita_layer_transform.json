          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "request_id"
        ],
        "additionalProperties": false
      },
      "layer_id": {
        "type": "string",
        "minLength": 1
      },
      "operation": {
        "description": "One transform per call.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "translate"
              },
              "by_px": {
                "description": "[x, y] in whole canvas px, each -16384 to 16384 and not both 0, added to the layer's translation.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -16384,
                  "maximum": 16384
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "type",
              "by_px"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
