{
  "name": "krita_resource_list",
  "description": "Discover available brushes, profiles, palettes and blend modes.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "brush",
          "profile",
          "palette",
          "blend_mode"
        ]
      },
      "cursor": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "kind",
      "cursor",
      "limit"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.1.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "resources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "supported_settings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 0
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "sha256",
                    "supported_settings"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "next_cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "resources",
              "next_cursor"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string"
                      },
                      "supported_settings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 0
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "sha256",
                      "supported_settings"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "next_cursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "resources",
                "next_cursor"
              ],
              "additionalProperties": false
            },
            "error": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "failed"
            }
          }
        },
        "then": {
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "kind": "brush",
      "cursor": null,
      "limit": 20
    },
    "structuredContent": {
      "api_version": "0.1.0",
      "status": "completed",
      "document_id": null,
      "revision": null,
      "operation_id": null,
      "data": {
        "resources": [
          {
            "id": "brush-ink-1",
            "name": "Ink",
            "sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
            "supported_settings": [
              "size_px",
              "opacity",
              "flow",
              "color",
              "pressure",
              "eraser",
              "smoothing",
              "antialias"
            ]
          }
        ],
        "next_cursor": null
      },
      "error": null
    }
  }
}
