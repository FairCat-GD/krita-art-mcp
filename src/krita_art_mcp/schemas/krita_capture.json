{
  "name": "krita_capture",
  "description": "Return a fresh crop of a layer, a transparency mask, the composite or the selection, in one of two forms. Native: scale 1, the stored pixels, e.g. {scale: 1, filter: nearest}. Resampled: any other scale, e.g. {scale: 0.25, filter: lanczos, background: checker}. It returns the image and its PNG's path.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "source": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "document_id",
          "frame"
        ],
        "additionalProperties": false
      },
      "target": {
        "description": "A layer capture is the layer's own pixels, without its opacity, masks or inherit-alpha clip. A mask capture is a transparency mask's coverage alone, as grey: white shows, black hides.",
        "type": "string",
        "enum": [
          "composite",
          "layer",
          "selection",
          "mask"
        ]
      },
      "layer_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "rect": {
        "description": "Canvas px.",
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "scale": {
        "description": "1 is the native form, which takes no background or greyscale. Any other scale resamples with filter, then composites onto background.",
        "type": "number",
        "exclusiveMinimum": 0
      },
      "filter": {
        "description": "The resampling filter; the native form resamples nothing.",
        "type": "string",
        "enum": [
          "nearest",
          "box",
          "bilinear",
          "hamming",
          "bicubic",
          "lanczos"
        ]
      },
      "background": {
        "description": "Resampled form only, not for a selection. checker by default.",
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "checker",
              "transparent"
            ]
          },
          {
            "type": "object",
            "properties": {
              "space": {
                "type": "string",
                "enum": [
                  "srgb"
                ]
              },
              "rgba": {
                "description": "sRGB, each 0 to 1.",
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "space",
              "rgba"
            ],
            "additionalProperties": false
          }
        ]
      },
      "greyscale": {
        "description": "Resampled form only, not for a selection.",
        "type": "boolean"
      },
      "max_px": {
        "description": "The image's longest edge in px, 1 to 4096; 1600 by default. Tile for more.",
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      }
    },
    "required": [
      "source",
      "target",
      "layer_id",
      "rect",
      "scale",
      "filter"
    ],
    "additionalProperties": false,
    "dependentSchemas": {
      "target": {
        "if": {
          "properties": {
            "target": {
              "enum": [
                "layer",
                "mask"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "layer_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "target": {
                "const": "mask"
              }
            }
          },
          "then": {
            "properties": {
              "background": {
                "not": {}
              },
              "greyscale": {
                "not": {}
              }
            }
          }
        },
        "else": {
          "properties": {
            "layer_id": {
              "type": "null"
            }
          },
          "if": {
            "properties": {
              "target": {
                "const": "selection"
              }
            }
          },
          "then": {
            "properties": {
              "background": {
                "not": {}
              },
              "greyscale": {
                "not": {}
              }
            }
          }
        }
      },
      "scale": {
        "if": {
          "properties": {
            "scale": {
              "const": 1
            }
          }
        },
        "then": {
          "properties": {
            "background": {
              "not": {}
            },
            "greyscale": {
              "not": {}
            }
          }
        }
      }
    }
  },
