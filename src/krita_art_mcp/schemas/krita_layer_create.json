{
  "name": "krita_layer_create",
  "description": "Add an empty, editable paint or group layer under the root or a group, or a transparency mask on a paint layer, directly above a sibling, or on top when above_id is null; one undo step. A mask shows its layer where it is white and hides it where black; it starts from coverage all, none or the selection, and is checked against protection like a stroke. Example: {type: transparency_mask, parent_id: <a paint layer>, coverage: selection}.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guard": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "request_id"
        ],
        "additionalProperties": false
      },
      "parent_id": {
        "type": "string",
        "minLength": 1
      },
      "above_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "paint",
          "group",
          "transparency_mask"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "coverage": {
        "description": "For a transparency mask only, and required for one: all shows the whole layer, none hides it, selection copies the current selection's coverage.",
        "type": "string",
        "enum": [
          "all",
          "none",
          "selection"
        ]
      }
    },
    "required": [
      "guard",
      "parent_id",
      "above_id",
      "type",
      "name"
    ],
    "additionalProperties": false,
    "dependentSchemas": {
      "type": {
        "if": {
          "properties": {
            "type": {
              "const": "transparency_mask"
            }
          }
        },
        "then": {
          "required": [
            "coverage"
          ]
        },
        "else": {
          "properties": {
            "coverage": {
              "not": {}
            }
          }
        }
      }
    }
  },
