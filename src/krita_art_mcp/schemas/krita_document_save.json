{
  "name": "krita_document_save",
  "description": "Save a new layered revision and verify it by reopening a copy.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guard": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "request_id"
        ],
        "additionalProperties": false
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "overwrite": {
        "const": false
      },
      "verify_reopen": {
        "const": true
      }
    },
    "required": [
      "guard",
      "path",
      "overwrite",
      "verify_reopen"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.2.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "type": "null"
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reopened_verified": {
                "const": true
              },
              "layers_preserved": {
                "type": "boolean"
              },
              "baseline_untouched": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "composite_preserved": {
                "const": true
              },
              "expected_losses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "layer_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lost": {
                      "type": "string",
                      "enum": [
                        "node",
                        "type",
                        "alpha_locked",
                        "opacity"
                      ]
                    }
                  },
                  "required": [
                    "layer_id",
                    "name",
                    "type",
                    "lost"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "sha256",
              "reopened_verified",
              "layers_preserved",
              "baseline_untouched",
              "composite_preserved",
              "expected_losses"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "UNSUPPORTED_CAPABILITY",
                  "KRITA_NOT_RUNNING",
                  "PROTOCOL_MISMATCH",
                  "KRITA_MODAL_DIALOG",
                  "MULTIPLE_WINDOWS",
                  "BUSY",
                  "TIMEOUT",
                  "CANCELLED",
                  "REQUEST_ID_CONFLICT",
                  "DOCUMENT_NOT_FOUND",
                  "LAYER_NOT_FOUND",
                  "LOCKED_TARGET",
                  "LAYER_NOT_PAINTABLE",
                  "LAYER_HAS_LOCAL_SELECTION",
                  "PROTECTED_REGION_CHANGED",
                  "OUTSIDE_ALLOWED_MASK",
                  "RESOURCE_HASH_MISMATCH",
                  "SOURCE_HASH_MISMATCH",
                  "COLOR_PROFILE_MISMATCH",
                  "DOCUMENT_DIRTY",
                  "DOCUMENT_UNSAFE",
                  "DOCUMENT_READ_ONLY",
                  "DOCUMENT_IN_USE",
                  "SAVE_VERIFY_FAILED",
                  "PATH_NOT_ALLOWED",
                  "FILE_EXISTS",
                  "IO_ERROR",
                  "ROLLBACK_FAILED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "if": {
      "properties": {
        "status": {
          "const": "completed"
        }
      }
    },
    "then": {
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reopened_verified": {
              "const": true
            },
            "layers_preserved": {
              "type": "boolean"
            },
            "baseline_untouched": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "composite_preserved": {
              "const": true
            },
            "expected_losses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "layer_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lost": {
                    "type": "string",
                    "enum": [
                      "node",
                      "type",
                      "alpha_locked",
                      "opacity"
                    ]
                  }
                },
                "required": [
                  "layer_id",
                  "name",
                  "type",
                  "lost"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "path",
            "sha256",
            "reopened_verified",
            "layers_preserved",
            "baseline_untouched",
            "composite_preserved",
            "expected_losses"
          ],
          "additionalProperties": false
        },
        "error": {
          "type": "null"
        }
      }
    },
    "else": {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        },
        "required": [
          "error"
        ]
      },
      "else": {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "guard": {
        "document_id": "doc-1",
        "request_id": "req-001"
      },
      "path": "/projects/demo/revisions/hero-r02.kra",
      "overwrite": false,
      "verify_reopen": true
    },
    "structuredContent": {
      "api_version": "0.2.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": null,
      "operation_id": null,
      "data": {
        "path": "/projects/demo/revisions/hero-r02.kra",
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "reopened_verified": true,
        "layers_preserved": true,
        "baseline_untouched": true,
        "composite_preserved": true,
        "expected_losses": []
      },
      "error": null
    }
  }
}
