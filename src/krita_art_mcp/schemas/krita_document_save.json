{
  "name": "krita_document_save",
  "description": "Save a new layered revision and verify it by reopening a copy.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guard": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "expected_revision",
          "request_id"
        ],
        "additionalProperties": false
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "overwrite": {
        "const": false
      },
      "verify_reopen": {
        "const": true
      }
    },
    "required": [
      "guard",
      "path",
      "overwrite",
      "verify_reopen"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.1.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "reopened_verified": {
                "type": "boolean"
              },
              "layers_preserved": {
                "type": "boolean"
              },
              "baseline_untouched": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "sha256",
              "reopened_verified",
              "layers_preserved",
              "baseline_untouched"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "reopened_verified": {
                  "type": "boolean"
                },
                "layers_preserved": {
                  "type": "boolean"
                },
                "baseline_untouched": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "sha256",
                "reopened_verified",
                "layers_preserved",
                "baseline_untouched"
              ],
              "additionalProperties": false
            },
            "error": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "failed"
            }
          }
        },
        "then": {
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "guard": {
        "document_id": "doc-1",
        "expected_revision": 12,
        "request_id": "req-001"
      },
      "path": "/projects/demo/revisions/hero-r02.kra",
      "overwrite": false,
      "verify_reopen": true
    },
    "structuredContent": {
      "api_version": "0.1.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": 12,
      "operation_id": null,
      "data": {
        "path": "/projects/demo/revisions/hero-r02.kra",
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "reopened_verified": true,
        "layers_preserved": true,
        "baseline_untouched": true
      },
      "error": null
    }
  }
}
