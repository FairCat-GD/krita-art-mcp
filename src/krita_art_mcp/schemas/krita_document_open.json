          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "uniqueItems": true,
        "maxItems": 1024
      },
      "editable_layer_names": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true,
        "maxItems": 1024
      }
    },
    "required": [
      "source_path",
      "source_sha256",
      "mode",
      "request_id"
    ],
    "additionalProperties": false,
    "dependentSchemas": {
      "mode": {
        "if": {
          "properties": {
            "mode": {
              "const": "working_copy"
            }
          }
        },
        "then": {
          "required": [
            "working_dir"
          ]
        },
        "else": {
          "properties": {
            "working_dir": {
              "not": {}
            },
            "editable_layer_ids": {
              "not": {}
            },
            "editable_layer_names": {
              "not": {}
            }
          }
        }
      }
    }
  },
