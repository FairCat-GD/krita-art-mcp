{
  "name": "krita_document_open",
  "description": "Open a baseline and return an isolated working copy.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "source_path": {
        "type": "string",
        "minLength": 1
      },
      "source_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "mode": {
        "type": "string",
        "enum": [
          "working_copy",
          "read_only"
        ]
      },
      "request_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "project_id",
      "source_path",
      "source_sha256",
      "mode",
      "request_id"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.2.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "type": "null"
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "working_copy": {
                "type": "boolean"
              },
              "baseline_id": {
                "type": "string"
              },
              "source_sha256": {
                "type": "string"
              },
              "canvas_px": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 0
              },
              "root_layer_id": {
                "type": "string"
              }
            },
            "required": [
              "working_copy",
              "baseline_id",
              "source_sha256",
              "canvas_px",
              "root_layer_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "UNSUPPORTED_CAPABILITY",
                  "KRITA_NOT_RUNNING",
                  "PROTOCOL_MISMATCH",
                  "KRITA_MODAL_DIALOG",
                  "MULTIPLE_WINDOWS",
                  "BUSY",
                  "TIMEOUT",
                  "CANCELLED",
                  "REQUEST_ID_CONFLICT",
                  "DOCUMENT_NOT_FOUND",
                  "LAYER_NOT_FOUND",
                  "LOCKED_TARGET",
                  "LAYER_NOT_PAINTABLE",
                  "LAYER_HAS_LOCAL_SELECTION",
                  "PROTECTED_REGION_CHANGED",
                  "OUTSIDE_ALLOWED_MASK",
                  "RESOURCE_HASH_MISMATCH",
                  "SOURCE_HASH_MISMATCH",
                  "COLOR_PROFILE_MISMATCH",
                  "DOCUMENT_DIRTY",
                  "DOCUMENT_UNSAFE",
                  "DOCUMENT_READ_ONLY",
                  "DOCUMENT_IN_USE",
                  "SAVE_VERIFY_FAILED",
                  "PATH_NOT_ALLOWED",
                  "FILE_EXISTS",
                  "IO_ERROR",
                  "ROLLBACK_FAILED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "working_copy": {
                  "type": "boolean"
                },
                "baseline_id": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string"
                },
                "canvas_px": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 0
                },
                "root_layer_id": {
                  "type": "string"
                }
              },
              "required": [
                "working_copy",
                "baseline_id",
                "source_sha256",
                "canvas_px",
                "root_layer_id"
              ],
              "additionalProperties": false
            },
            "error": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "failed",
                "cancelled"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "null"
            },
            "error": {
              "type": "object"
            }
          },
          "required": [
            "error"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "project_id": "project-1",
      "source_path": "/projects/demo/accepted/hero.kra",
      "source_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "mode": "working_copy",
      "request_id": "req-open"
    },
    "structuredContent": {
      "api_version": "0.2.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": null,
      "operation_id": null,
      "data": {
        "working_copy": true,
        "baseline_id": "baseline-1",
        "source_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "canvas_px": [
          128,
          128
        ],
        "root_layer_id": "root-1"
      },
      "error": null
    }
  }
}
