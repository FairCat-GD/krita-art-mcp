          },
          "stroke.per_point_input": {
            "supported": false,
            "since": null,
            "notes": "Per-point pressure, tilt, rotation and timing need Krita 6.1 / 5.4."
          },
          "stroke.smoothing": {
            "supported": false,
            "since": null,
            "notes": "Server-side smoothing (none, catmull_rom) comes with native brush strokes."
          },
          "undo.grouping": {
            "supported": false,
            "since": null,
            "notes": "Krita's scripting API cannot group undo steps; each change is its own step."
          },
          "stroke.deterministic": {
            "supported": false,
            "since": null,
            "notes": "Stochastic presets have no seed control, so their strokes do not repeat exactly."
          },
          "operation.cancel_running": {
            "supported": false,
            "since": null,
            "notes": "A running Krita call cannot be interrupted; only queued operations can be cancelled."
          },
          "selection.enforced": {
            "supported": false,
            "since": null,
            "notes": "krita_selection_set sets the selection; strokes that keep to it arrive with native brush strokes."
          },
          "color_spaces": {
            "supported": false,
            "since": null,
            "notes": "Documents are not created or painted in this release; Phase 1 paints RGBA / U8 / sRGB."
          },
