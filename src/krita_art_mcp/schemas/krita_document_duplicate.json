{
  "name": "krita_document_duplicate",
  "description": "Branch a document: save it to a new .kra path inside an allowed root, verify the file by reopening it, and open that file as a document of its own, to try a whole alternative. The branch keeps every layer id and the source's protection, allowed mask and flags, starts with empty history and its own baseline_id, and takes the source's mode. The source is left as it was, its dirty flag included. new_document_id names the branch; compare the two with krita_preview_render, one source each.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guard": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "request_id"
        ],
        "additionalProperties": false
      },
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "An absolute path to a new .kra file inside an allowed root; nothing is overwritten."
      }
    },
    "required": [
      "guard",
      "path"
    ],
    "additionalProperties": false
  },
