{
  "name": "krita_protection_set",
  "description": "Bind or tighten preservation policy against a checkpoint.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "guard": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "expected_revision",
          "request_id"
        ],
        "additionalProperties": false
      },
      "checkpoint_id": {
        "type": "string",
        "minLength": 1
      },
      "protected_layer_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 0,
        "maxItems": 1024
      },
      "allowed_change_mask": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "uri",
              "sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "preserve_composite_alpha": {
        "type": "boolean"
      },
      "preserve_canvas": {
        "type": "boolean"
      }
    },
    "required": [
      "guard",
      "checkpoint_id",
      "protected_layer_ids",
      "allowed_change_mask",
      "preserve_composite_alpha",
      "preserve_canvas"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "api_version": {
        "const": "0.1.0"
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "queued",
          "running",
          "failed",
          "cancelled"
        ]
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "revision": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "operation_id": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "data": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "protection_id": {
                "type": "string"
              },
              "protected_layer_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              },
              "composite_outside_mask": {
                "type": "string"
              },
              "preserve_composite_alpha": {
                "type": "boolean"
              }
            },
            "required": [
              "protection_id",
              "protected_layer_ids",
              "composite_outside_mask",
              "preserve_composite_alpha"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "api_version",
      "status",
      "document_id",
      "revision",
      "operation_id",
      "data",
      "error"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "type": "object",
              "properties": {
                "protection_id": {
                  "type": "string"
                },
                "protected_layer_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 0
                },
                "composite_outside_mask": {
                  "type": "string"
                },
                "preserve_composite_alpha": {
                  "type": "boolean"
                }
              },
              "required": [
                "protection_id",
                "protected_layer_ids",
                "composite_outside_mask",
                "preserve_composite_alpha"
              ],
              "additionalProperties": false
            },
            "error": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "failed"
            }
          }
        },
        "then": {
          "properties": {
            "error": {
              "type": "object"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "queued",
                "running"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "operation_id": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "null"
            },
            "error": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "example": {
    "input": {
      "guard": {
        "document_id": "doc-1",
        "expected_revision": 12,
        "request_id": "req-001"
      },
      "checkpoint_id": "cp-1",
      "protected_layer_ids": [
        "base-1"
      ],
      "allowed_change_mask": {
        "uri": "krita-artifact://example/allowed.png",
        "sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      },
      "preserve_composite_alpha": true,
      "preserve_canvas": true
    },
    "structuredContent": {
      "api_version": "0.1.0",
      "status": "completed",
      "document_id": "doc-1",
      "revision": 13,
      "operation_id": null,
      "data": {
        "protection_id": "protect-1",
        "protected_layer_ids": [
          "base-1"
        ],
        "composite_outside_mask": "exact",
        "preserve_composite_alpha": true
      },
      "error": null
    }
  }
}
